{
  "note": "The content types this surface's artifacts take, beside the core's (image, swatch, render, brand-mark — sturij-core-editor src/assets/content-types.json). Declared here so the configurator's types — material, handle, room — exist as data before the Studio lands on the core (2dd904c6).",
  "types": [
    {
      "id": "copy",
      "description": "A text slot on the page — free text is content here, not a property; edited in place by an admin and versioned in site_content_slots.",
      "required": [
        {
          "name": "text",
          "kind": "string"
        }
      ],
      "composable": [],
      "approver": "owner"
    },
    {
      "id": "material",
      "description": "A decor for doors or carcass — a registry product by code where one exists (Egger, sturij-assets), else the handoff's name with its misfit.",
      "required": [
        {
          "name": "name",
          "kind": "string"
        }
      ],
      "composable": [
        {
          "name": "code",
          "kind": "ref",
          "resolves": "materials-registry"
        },
        {
          "name": "swatch",
          "kind": "ref",
          "resolves": "asset"
        },
        {
          "name": "gradient",
          "kind": "list"
        }
      ]
    },
    {
      "id": "handle",
      "description": "A handle finish — the handoff's procedural metals today; a Häfele product by code when the registry names a finish family.",
      "required": [
        {
          "name": "name",
          "kind": "string"
        }
      ],
      "composable": [
        {
          "name": "swatch",
          "kind": "ref",
          "resolves": "asset"
        }
      ]
    },
    {
      "id": "room",
      "description": "A room finish (ceiling, walls, skirting, flooring) — the prototype's colour data until paints are registry records; and the room a visual renders into (bedroom, living room, kitchen, hallway).",
      "required": [
        {
          "name": "name",
          "kind": "string"
        }
      ],
      "composable": [
        {
          "name": "category",
          "kind": "enum",
          "values": [
            "ceiling",
            "walls",
            "skirting",
            "flooring"
          ]
        }
      ]
    },
    {
      "id": "enquiry",
      "description": "The enquiry the form posts — the customer table's front door on sturij-web (mail-gate G5; form-surface §5.1); the visitor's swatch travels with it as data.",
      "required": [
        {
          "name": "name",
          "kind": "string"
        },
        {
          "name": "email",
          "kind": "string"
        }
      ],
      "composable": [
        {
          "name": "phone",
          "kind": "string"
        },
        {
          "name": "postcode",
          "kind": "string"
        },
        {
          "name": "room",
          "kind": "string"
        },
        {
          "name": "notes",
          "kind": "string"
        },
        {
          "name": "finishes",
          "kind": "string"
        }
      ]
    },
    {
      "id": "configuration",
      "description": "What is being made — the SPA's set: the fitted run and the four pieces — with its width range, its options and its drawing (data/band-table.json).",
      "required": [
        {
          "name": "name",
          "kind": "string"
        },
        {
          "name": "widthMm",
          "kind": "measure",
          "unit": "mm"
        }
      ],
      "composable": [
        {
          "name": "option",
          "kind": "enum",
          "values": [
            "classic",
            "hishers",
            "drawers",
            "dressing"
          ]
        }
      ]
    },
    {
      "id": "tier",
      "description": "A specification tier — Standard, Signature, Atelier — each a rule on materials and hardware stated in one line (the SPA's tiers; a registry rule later).",
      "required": [
        {
          "name": "name",
          "kind": "string"
        },
        {
          "name": "line",
          "kind": "string"
        }
      ],
      "composable": []
    },
    {
      "id": "band",
      "description": "A from–to guide computed from the versioned band table, rounded to £5 at both ends, watermarked; a derived value shown with its derivation (form-surface F13); never a single figure presented as a price.",
      "required": [
        {
          "name": "from",
          "kind": "number"
        },
        {
          "name": "to",
          "kind": "number"
        },
        {
          "name": "tableVersion",
          "kind": "number"
        }
      ],
      "composable": [
        {
          "name": "derivation",
          "kind": "list"
        }
      ]
    },
    {
      "id": "section",
      "description": "A content section from the copy family as data (content/sections/<id>.json): parts with blocks of lines, a FAQ, a claims register. Every line is a copy slot; a line whose claim is [P] renders nothing until Mark closes the row.",
      "required": [
        {
          "name": "parts",
          "kind": "list"
        },
        {
          "name": "claims",
          "kind": "list"
        }
      ],
      "composable": [
        {
          "name": "faq",
          "kind": "list"
        },
        {
          "name": "extra",
          "kind": "list"
        }
      ],
      "approver": "owner"
    },
    {
      "id": "faq",
      "description": "A visible question-and-answer accordion drawn from a section; the same items feed FAQPage structured data — nothing hidden for crawlers.",
      "required": [
        {
          "name": "q",
          "kind": "string"
        },
        {
          "name": "a",
          "kind": "list"
        }
      ],
      "composable": [
        {
          "name": "claims",
          "kind": "list"
        }
      ]
    },
    {
      "id": "claim",
      "description": "A row of a claims register: claim, location, status (P | ours | sourced | general | dropped), source. [P] at go-live means the line is not on the page; closing a row is a data edit with a line in the slot table (claim.<section>.<row>).",
      "required": [
        {
          "name": "claim",
          "kind": "string"
        },
        {
          "name": "location",
          "kind": "string"
        },
        {
          "name": "status",
          "kind": "enum",
          "values": [
            "P",
            "ours",
            "sourced",
            "general",
            "dropped"
          ]
        },
        {
          "name": "source",
          "kind": "string"
        }
      ],
      "composable": [
        {
          "name": "sourcedOn",
          "kind": "string"
        },
        {
          "name": "note",
          "kind": "string"
        }
      ]
    },
    {
      "id": "partner",
      "description": "A supporting trade or partner as a record (content/partners.json): renders only its publishable fields, only with consent on record and a review date not yet passed; registrations stay on record, never on the page.",
      "required": [
        {
          "name": "trade",
          "kind": "string"
        },
        {
          "name": "name",
          "kind": "string"
        },
        {
          "name": "publishable",
          "kind": "list"
        },
        {
          "name": "consent",
          "kind": "string"
        },
        {
          "name": "reviewDate",
          "kind": "string"
        }
      ],
      "composable": [
        {
          "name": "contact",
          "kind": "string"
        },
        {
          "name": "phone",
          "kind": "string"
        },
        {
          "name": "email",
          "kind": "string"
        },
        {
          "name": "website",
          "kind": "string"
        },
        {
          "name": "blurb",
          "kind": "string"
        }
      ]
    },
    {
      "id": "identity",
      "description": "The business identity record (content/identity.json): the trading name and legal entity paired, the NAP, the registered office — the same values in the footer, the structured data and the legal pages.",
      "required": [
        {
          "name": "legalName",
          "kind": "string"
        },
        {
          "name": "tradingName",
          "kind": "string"
        },
        {
          "name": "companyNumber",
          "kind": "string"
        }
      ],
      "composable": []
    },
    {
      "id": "legal",
      "description": "A governed legal document rendered byte-faithful from its record (the version and date in the page footer; never hand-edited on the site; re-rendered when the record's version changes).",
      "required": [
        {
          "name": "content",
          "kind": "string"
        },
        {
          "name": "version",
          "kind": "number"
        },
        {
          "name": "sha256",
          "kind": "string"
        }
      ],
      "composable": [
        {
          "name": "externalId",
          "kind": "string"
        }
      ]
    },
    {
      "id": "review",
      "description": "A first-party review as a record: the customer, their words, the date, the permission on record — never edited, withdrawn on request; structured data only from qualifying rows.",
      "required": [
        {
          "name": "customer",
          "kind": "string"
        },
        {
          "name": "text",
          "kind": "string"
        },
        {
          "name": "date",
          "kind": "string"
        },
        {
          "name": "permission",
          "kind": "string"
        }
      ],
      "composable": [
        {
          "name": "rating",
          "kind": "number"
        },
        {
          "name": "project",
          "kind": "string"
        }
      ]
    }
  ]
}

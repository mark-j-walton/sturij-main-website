# Names only — values come from the vault (/STURIJ) through the Vercel sync. Never a value in this repo.
# Public (safe in the browser bundle): the sturij-web project URL and its publishable key — the admin login and slot reads.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: the Gemini key for /api/render (the estate's GEMINI_API_KEY name), the image model, and the render limits.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
RENDER_LIMIT_PER_VISITOR_HOUR=6
RENDER_LIMIT_PER_DAY=60
# Server only: where the enquiry lands (sturij-web's enquiry function; not a secret — the endpoint is anonymous by design).
ENQUIRY_FUNCTION_URL=https://bcpmgpktmuaicjessseg.supabase.co/functions/v1/enquiry

# Names only — values come from the vault (/STURIJ) through the Vercel sync. Never a value in this repo.
# Public (safe in the browser bundle): the sturij-web project URL and its publishable key — the admin login and the copy slots.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# sturij-assets (uxdrokyxywwezorpvfsp), the one asset store — the image slots (lib/slot-store.ts).
# Server only: the project's publishable (anon) key, for the read of public media rows; and asset-ingest's token
# (the vault's /STURIJ_ASSETS/functions ASSET_INGEST_TOKEN), held by the server route /api/slots/image, never the browser.
# STURIJ_ASSETS_URL is optional (defaults to https://uxdrokyxywwezorpvfsp.supabase.co).
STURIJ_ASSETS_ANON_KEY=
ASSET_INGEST_TOKEN=
STURIJ_ASSETS_URL=
# Build only, optional: the materials feed reads registry-showcase with no key; STURIJ_ASSETS_READ_KEY is used only by
# `node scripts/materials-feed.mjs --rest` (the direct table read).
STURIJ_ASSETS_READ_KEY=
# Server only: the Gemini key for /api/render (the estate's GEMINI_API_KEY name), the image model, and the render limits.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
RENDER_LIMIT_PER_VISITOR_HOUR=6
RENDER_LIMIT_PER_DAY=60
# Server only: where the enquiry lands (sturij-web's enquiry function; not a secret — the endpoint is anonymous by design).
ENQUIRY_FUNCTION_URL=https://bcpmgpktmuaicjessseg.supabase.co/functions/v1/enquiry

# NOT THIS PROJECT'S NAME — recorded here so the next reader does not add it by mistake.
# NOTIFY_TO (Mark's decision: the contact address) is read by sturij-web's `enquiry` edge
# function (notify.ts, sturij #60 — `NOTIFY_TO` falling back to `NOTIFY_FROM`), so its store is
# that project's Supabase function secrets, not this project's Vercel environment. Nothing in
# this repository reads it: the site posts to ENQUIRY_FUNCTION_URL and the function notifies.
# A vault sync that carried it here would put the name in the wrong store.

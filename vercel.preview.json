{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "www.sturij.com" }], "destination": "https://sturij.com/$1", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/studio-preview" },
    { "source": "/p/:id", "destination": "/api/p/[id]" },
    { "source": "/:path*", "destination": "/public/:path*" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }] }
  ]
}
